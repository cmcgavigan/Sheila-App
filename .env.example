# ---- Sheila App v2 ----------------------------------------------------------
# Copy to .env and fill in. The installer copies your v1 .env automatically if
# it finds one in the parent folder.

# Server (v2 defaults leave room to run alongside v1 during switchover)
PORT=3002
HOSTNAME_LOCAL=sheila.local
TS_HTTPS_PORT=8444
# PUBLIC_URL=            # optional override; otherwise Tailscale is auto-detected

# Groq vision OCR — free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# OpenRouteService (trip auto-distance) — free key: https://openrouteservice.org
ORS_API_KEY=

# Treatments editor PIN
TREATMENTS_PIN=1234

# Phone alerts via ntfy (optional; leave topic empty to disable)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
WATCHDOG_ALERT_HOURS=0

# Backups (nightly 02:30, zip of DB+photos+.env into data/backups)
BACKUP_RETENTION_DAYS=30
# GDRIVE_BACKUP_DIR=     # optional second copy into a cloud-synced folder
